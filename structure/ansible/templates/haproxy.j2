defaults
    maxconn 20000
    mode    tcp
    option  dontlognull
    timeout http-request 10s
    timeout queue        1m
    timeout connect      10s
    timeout client       86400s
    timeout server       86400s
    timeout tunnel       86400s

frontend k8s-api
    bind :::6443 v4v6
    mode tcp
    default_backend k8s-api

backend k8s-api
    mode tcp
    balance roundrobin
    default-server verify none inter 10s downinter 5s rise 2 fall 2 maxconn 5000
    {% for server in groups['control_plane'] %}
    server {{ server }} {{ hostvars[server]['ansible_host'] | default(server) }}:6443 check
    {% endfor %}

frontend http-in
    bind *:80
    mode tcp
    default_backend ingress-http

backend ingress-http
    mode tcp
    balance roundrobin
    {% for server in groups['workers'] %}
    server {{ server }} {{ hostvars[server]['ansible_host'] | default(server) }}:30080 check
    {% endfor %}
